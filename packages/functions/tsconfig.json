{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@furr/core": ["../core/src"]
    }
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}

rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Furr — Firebase Storage Security Rules
// ─────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB max
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isImageOrDoc() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/pdf');
    }

    // User pet medical documents & health dossiers (Restricted to owner & admin)
    match /users/{uid}/pets/{petId}/documents/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && isValidSize() && isImageOrDoc();
    }

    // Pet profile avatars (Read by community/clinics, write by owner only)
    match /users/{uid}/pets/{petId}/avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidSize() && isImage();
    }

    // Lost & Found alert photos (Scoped by UID to prevent overwrite collisions)
    match /lostfound/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidSize() && isImage();
    }

    // Legacy lost & found path compatibility
    match /lostfound/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidSize() && isImage();
    }

    // Marketplace product images (Public read for web/app, write by admin/seller)
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.seller == true);
    }

    // User review upload photos
    match /reviews/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidSize() && isImage();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

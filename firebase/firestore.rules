rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Furr — Firestore Security Rules
//
//  These rules enforce the complete permission matrix:
//  - Owners can only read/write their own data.
//  - Vets can read pet data only if they hold an active AccessGrant.
//  - Admins have access to operational and moderation data.
//  - Root collections are protected with strict role/ownership checks.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────

    // Is the request from a signed-in user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Is the request from this specific user?
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Does this user have a specific custom claim role?
    function hasRole(role) {
      return isSignedIn() && request.auth.token[role] == true;
    }

    // Is this user an admin?
    function isAdmin() {
      return hasRole('admin');
    }

    // ── Vet grant access helper ───────────────────────────────
    function hasActiveGrant(ownerUid, petId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUid)/grants/$(request.auth.uid + '_' + petId))
        && get(/databases/$(database)/documents/users/$(ownerUid)/grants/$(request.auth.uid + '_' + petId)).data.status == 'redeemed'
        && get(/databases/$(database)/documents/users/$(ownerUid)/grants/$(request.auth.uid + '_' + petId)).data.redeemedByUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(ownerUid)/grants/$(request.auth.uid + '_' + petId)).data.grantExpiresAt > request.time;
    }

    // ── User Profiles & Subcollections ───────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // Deletions handled by admin process

      match /billing_history/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) || isAdmin();
        allow delete: if false;
      }
    }


    // ── Pets & Subcollections ─────────────────────────────────
    match /users/{ownerUid}/pets/{petId} {
      allow read: if isOwner(ownerUid) || isAdmin() || hasActiveGrant(ownerUid, petId);
      allow create: if isOwner(ownerUid);
      allow update: if isOwner(ownerUid);
      allow delete: if false; // Use archive instead

      match /vaccinations/{docId} {
        allow read: if isOwner(ownerUid) || isAdmin() || hasActiveGrant(ownerUid, petId);
        allow create: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid);
        allow delete: if false;
      }

      match /medications/{docId} {
        allow read: if isOwner(ownerUid) || isAdmin() || hasActiveGrant(ownerUid, petId);
        allow create: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid);
        allow delete: if false;
      }

      match /weights/{docId} {
        allow read: if isOwner(ownerUid) || isAdmin() || hasActiveGrant(ownerUid, petId);
        allow create: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid);
        allow delete: if isOwner(ownerUid);
      }

      match /observations/{docId} {
        allow read: if isOwner(ownerUid) || isAdmin() || hasActiveGrant(ownerUid, petId);
        allow create: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid);
        allow delete: if false;
      }

      match /flags/{docId} {
        allow read: if isOwner(ownerUid) || isAdmin() || hasActiveGrant(ownerUid, petId);
        allow create: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid);
        allow delete: if false;
      }

      match /documents/{docId} {
        allow read: if isOwner(ownerUid) || isAdmin() || hasActiveGrant(ownerUid, petId);
        allow create: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid);
        allow delete: if false;
      }

      match /reminders/{docId} {
        allow read: if isOwner(ownerUid) || isAdmin();
        allow create: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid);
        allow delete: if false;
      }
    }

    // ── Access Grants (Sharing) ───────────────────────────────
    match /users/{ownerUid}/grants/{grantId} {
      allow read: if isOwner(ownerUid)
                  || isAdmin()
                  || (isSignedIn() && resource.data.redeemedByUid == request.auth.uid);
      allow create: if isOwner(ownerUid);
      allow update: if isOwner(ownerUid)
                    || (isSignedIn()
                        && resource.data.status == 'active'
                        && request.resource.data.status == 'redeemed'
                        && request.resource.data.redeemedByUid == request.auth.uid);
      allow delete: if false;
    }

    // ── Root Collections (Protected - SEC-001) ─────────────────

    // Routines
    match /routines/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Expenses
    match /expenses/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Care Feeding Schedules
    match /care_feeding_schedules/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Care Walk Activities
    match /care_walk_activities/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Family Members
    match /family_members/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Insurance Policies
    match /insurance_policies/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Lost Pet Alerts
    match /lost_pet_alerts/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Found Pet Reports
    match /found_pet_reports/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
    }

    // Community Meetups
    match /community_meetups/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.hostUid == request.auth.uid || isAdmin());
    }

    // Community Questions & Discussions
    match /community_questions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Upvoting / answering allowed by authenticated users
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Marketplace Products
    match /marketplace_products/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }


    // Marketplace Orders
    match /marketplace_orders/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Service Providers
    match /service_providers/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == docId);
      allow delete: if isAdmin();
    }

    // Service Bookings
    match /service_bookings/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Adoption Listings
    match /adoption_listings/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || (isSignedIn() && resource.data.shelterId == request.auth.uid);
    }

    // Adoption Applications
    match /adoption_applications/{docId} {
      allow read: if isSignedIn() && (resource.data.applicantUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.applicantUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Universal Reviews
    match /reviews/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn(); // Helpful voting
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }


    // Telemedicine Consultations
    match /telemedicine_consultations/{docId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.vetUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.vetUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Telemedicine Messages
    match /telemedicine_messages/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Payment Intents & Checkout Sessions
    match /payment_intents/{docId} {
      allow read: if isSignedIn() && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }


    // ── Clinics & Hospital Registry ──────────────────────────
    match /clinics/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Veterinarian Registry ─────────────────────────────────
    match /vets/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == docId);
      allow delete: if isAdmin();
    }

    // ── Disputes & Trust Resolution ───────────────────────────
    match /disputes/{docId} {
      allow read: if isSignedIn() && (resource.data.complainantUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Professional Profiles ─────────────────────────────────
    match /professionals/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin(); // Only admin can verify/suspend
      allow delete: if false;
    }

    // ── Admin Operational Collections ────────────────────────
    match /admin_vet_applications/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /admin_clinics/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admin_disputes/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    match /admin_payouts/{docId} {
      allow read, write: if isAdmin();
    }

    match /provider_payouts/{docId} {
      allow read: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // ── Clinic Operations Collections ─────────────────────────
    match /clinic_queue/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || hasRole('clinic_admin') || hasRole('vet');
    }

    match /clinic_appointments/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || hasRole('clinic_admin');
    }

    match /clinic_staff/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole('clinic_admin');
    }

    // ── Default deny ──────────────────────────────────────────
  }
}

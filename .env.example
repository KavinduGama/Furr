# ─────────────────────────────────────────────────────────────
#  Furr Platform — Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────

# ── For React Native (Expo) Apps (furr-owner, furr-vet-mobile) ──
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=furr-production.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=furr-production
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=furr-production.appspot.com
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:android:abcdef123456
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# ── For Next.js Web Apps (furr-admin, furr-vet, furr-clinic) ─────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=furr-production.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=furr-production
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=furr-production.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# ── Payment Gateway Credentials (Cloud Functions / App Secrets) ──
# Stripe Configuration (Card payments & subscriptions)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# PayHere Sri Lanka Configuration (Local wallets: Genie, EzCash, Frimi)
PAYHERE_MERCHANT_ID=121XXXX
PAYHERE_MERCHANT_SECRET=XXXXXXXXXXXX
PAYHERE_APP_ID=XXXXXXXX
PAYHERE_APP_SECRET=XXXXXXXX

# ── Production SMS & Push Notifications ─────────────────────────
# Sri Lanka SMS Gateway (e.g. Notify.lk / Dialog / Mobitel SMS API)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=FURR_CARE

# Expo Push Notifications Access Token
EXPO_ACCESS_TOKEN=
